#!/usr/bin/env bash
# codexbar-cookie-importer — Extract browser cookies for CodexBar providers.
# Zero Python/PyPI dependencies. Uses: secret-tool, openssl, sqlite3.
# Replaces the codexbar-cookie-importer PyPI package.
set -euo pipefail

VERSION="2.1.0"

# --- Provider configs ---
PROVIDER="codex"
PROFILE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --provider=*) PROVIDER="${1#--provider=}" ;;
    --provider) PROVIDER="${2:-codex}"; shift ;;
    --profile) PROFILE="${2:?--profile requires a Cookies database path}"; shift ;;
    *) : ;;
  esac
  shift
done
PROVIDER="$(echo "$PROVIDER" | tr '[:upper:]' '[:lower:]')"

case "$PROVIDER" in
  codex)
    DISPLAY_NAME="ChatGPT/OpenAI"
    DOMAINS=("chatgpt.com" "openai.com")
    REQUIRED_COOKIE="session-token"
    PRIORITY_COOKIES=("session-token")
    TARGETS=("session-token" "oai-did" "oai-sc" "cf_clearance" "_cf_bm" "oai-is" "oai-allow" "oai-chat-web-route" "oai-client-auth-info")
    ;;
  ollama)
    DISPLAY_NAME="Ollama"
    DOMAINS=("ollama.com")
    REQUIRED_COOKIE=""
    PRIORITY_COOKIES=("session" "auth" "token")
    TARGETS=("session" "auth" "token" "csrf" "intercom")
    ;;
  opencode|opencodego)
    DISPLAY_NAME="OpenCode Console"
    DOMAINS=("opencode.ai")
    REQUIRED_COOKIE="__Host-console_session"
    PRIORITY_COOKIES=("__Host-console_session")
    TARGETS=("__Host-console_session")
    ;;
  *)
    printf '{"error":"UNSUPPORTED_PROVIDER","details":"Unsupported provider: %s"}\n' "$PROVIDER" >&2
    exit 1
    ;;
esac

# --- Dependency check ---
for cmd in openssl sqlite3 secret-tool; do
  command -v "$cmd" &>/dev/null || {
    printf '{"error":"DEPENDENCY_MISSING","details":"Required command not found: %s"}\n' "$cmd" >&2
    exit 1
  }
done

# --- Utility functions ---
json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

derive_aes_key() {
  openssl kdf -keylen 16 \
    -kdfopt digest:SHA1 \
    -kdfopt "pass:${1}" \
    -kdfopt salt:saltysalt \
    -kdfopt iter:1 \
    -binary PBKDF2 2>/dev/null
}

# --- Cookie validation (RFC6265 cookie-octet) ---
is_plausible_cookie_value() {
  local name="$1" value="$2"
  [[ -z "$value" ]] && return 1

  # RFC6265: %x21 / %x23-2B / %x2D-3A / %x3C-5B / %x5D-7E
  if ! printf '%s' "$value" | LC_ALL=C grep -qP '^[\x21\x23-\x2b\x2d-\x3a\x3c-\x5b\x5d-\x7e]+$'; then
    return 1
  fi

  # session-token minimum length (unless chunked NextAuth token)
  if [[ "$name" == *"session-token"* ]]; then
    if ! printf '%s' "$name" | LC_ALL=C grep -qP '\.\d+$'; then
      [[ ${#value} -lt 100 ]] && return 1
    fi
  fi

  return 0
}

# --- Decrypt v10/v11 Chromium cookie ---
decrypt_v10() {
  local enc_hex="$1" key="$2"

  # Need at least 6 hex chars (v10 prefix) + 1 byte data
  [[ ${#enc_hex} -lt 8 ]] && return 1

  # Check v10/v11 prefix (hex: 763130 / 763131)
  local prefix="${enc_hex:0:6}"
  [[ "$prefix" != "763130" && "$prefix" != "763131" ]] && return 1

  local payload_hex="${enc_hex:6}"
  local aes_key
  aes_key="$(derive_aes_key "$key")" || return 1
  [[ -z "$aes_key" ]] && return 1

  # IV = 16 spaces
  local iv="20202020202020202020202020202020"

  # Decrypt
  local decrypted
  decrypted="$(printf '%s' "$payload_hex" | xxd -r -p 2>/dev/null | \
    openssl enc -aes-128-cbc -d -K "$aes_key" -iv "$iv" 2>/dev/null)" || return 1
  [[ -z "$decrypted" ]] && return 1

  # Validate PKCS#7 padding
  local padding_len
  padding_len="$(printf '%s' "$decrypted" | tail -c 1 | od -An -tu1 | tr -d ' ')"
  [[ -z "$padding_len" || "$padding_len" -lt 1 || "$padding_len" -gt 16 ]] && return 1

  # Verify all padding bytes
  local pad_char
  pad_char="$(printf '\\x%02x' "$padding_len")"
  local pad_check
  pad_check="$(printf '%s' "$decrypted" | tail -c "$padding_len" | LC_ALL=C tr -d "$pad_char")"
  [[ -n "$pad_check" ]] && return 1

  # Remove padding
  local unpadded
  unpadded="$(printf '%s' "$decrypted" | head -c "-${padding_len}")"

  # Try to find JWT start (ey...)
  local result=""
  local jwt_pos
  jwt_pos="$(printf '%s' "$unpadded" | LC_ALL=C grep -boa 'eyJ' 2>/dev/null | head -1 | cut -d: -f1)" || true

  if [[ -n "$jwt_pos" && "$jwt_pos" -lt 48 ]]; then
    result="$(printf '%s' "$unpadded" | tail -c "+$((jwt_pos + 1))")"
  else
    # Try common header offsets for v11
    local found=0
    for offset in 32 28 0; do
      local total
      total="$(printf '%s' "$unpadded" | wc -c)"
      if [[ $total -gt $offset ]]; then
        local candidate
        candidate="$(printf '%s' "$unpadded" | tail -c "+$((offset + 1))")"
        local first10
        first10="$(printf '%s' "$candidate" | head -c 10)"
        if [[ ${#first10} -ge 10 ]]; then
          local bad
          bad="$(printf '%s' "$first10" | LC_ALL=C tr -d '\x20-\x7e')" || true
          if [[ -z "$bad" ]]; then
            result="$candidate"
            found=1
            break
          fi
        fi
      fi
    done
    [[ $found -eq 0 ]] && result="$unpadded"
  fi

  [[ -z "$result" ]] && return 1

  # No null bytes
  printf '%s' "$result" | LC_ALL=C grep -qP '\x00' && return 1

  # RFC6265 validation
  printf '%s' "$result" | LC_ALL=C grep -qP '^[\x21\x23-\x2b\x2d-\x3a\x3c-\x5b\x5d-\x7e]+$' || return 1

  printf '%s' "$result"
}

# --- Collect keyring keys into a temp file (one base64-encoded key per line) ---
# Console cookies use the standard Linux v10/v11 format. Keep binary host hashes
# in hex until they have been verified, and let OpenSSL remove PKCS#7 padding.
hex_to_bytes() {
  local hex="$1" i
  for ((i=0; i<${#hex}; i+=2)); do printf '%b' "\\x${hex:i:2}"; done
}
bytes_to_hex() { od -An -v -tx1 | tr -d ' \n'; }

decrypt_console_cookie() {
  local enc_hex="$1" password="$2" host="$3" key_hex plain_hex host_hash
  [[ "${enc_hex:0:6}" == 763130 || "${enc_hex:0:6}" == 763131 ]] || return 1
  key_hex="$(derive_aes_key "$password" | bytes_to_hex)" || return 1
  plain_hex="$(hex_to_bytes "${enc_hex:6}" | \
    openssl enc -aes-128-cbc -d -K "$key_hex" -iv 20202020202020202020202020202020 2>/dev/null | bytes_to_hex)" || return 1
  host_hash="$(printf '%s' "$host" | openssl dgst -sha256 -binary | bytes_to_hex)"
  if [[ "${plain_hex:0:64}" == "$host_hash" ]]; then plain_hex="${plain_hex:64}"; fi
  # Reject binary data before converting it into a shell string.
  [[ "$plain_hex" =~ ^(21|2[3-9a-f]|[3-6][0-9a-f]|7[0-9a-e])+$ ]] || return 1
  hex_to_bytes "$plain_hex"
}

KEYS_FILE="$(mktemp /tmp/codexbar_keys_XXXXXX)"
TMPDB=""
trap 'rm -f "$KEYS_FILE" "$TMPDB"' EXIT

add_key() {
  local raw="$1"
  local b64
  b64="$(printf '%s' "$raw" | base64 -w0)"
  # Deduplicate
  grep -qF "$b64" "$KEYS_FILE" 2>/dev/null && return 0
  printf '%s\n' "$b64" >> "$KEYS_FILE"
}

# Retrieve keys via secret-tool
dbus_errors=""

# Search all Chromium-schema items
out=""
if out="$(secret-tool search --all xdg:schema chrome_libsecret_os_crypt_password_v2 2>&1)"; then
  label="" secret_b64=""
  while IFS= read -r line; do
    case "$line" in
      label\ =\ *)  label="${line#label = }" ;;
      secret\ =\ *) secret_b64="${line#secret = }" ;;
    esac
    if [[ -n "$secret_b64" ]]; then
      [[ "$PROVIDER" == opencode* ]] && add_key "$secret_b64"
      raw="$(printf '%s' "$secret_b64" | base64 -d 2>/dev/null)" || true
      if [[ -n "$raw" ]]; then
        skip=0
        echo "$label" | grep -qi "control" && skip=1
        [[ $skip -eq 0 ]] && add_key "$raw"
      fi
      label="" secret_b64=""
    fi
  done <<< "$out"
else
  dbus_errors="secret-tool search failed; "
fi

# Search by app_id (Vivaldi Flatpak)
for app_id in com.vivaldi.Vivaldi com.microsoft.Edge com.google.Chrome; do
  if out="$(secret-tool search --all app_id "$app_id" 2>/dev/null)"; then
    secret_b64=""
    while IFS= read -r line; do
      case "$line" in
        secret\ =\ *) secret_b64="${line#secret = }" ;;
      esac
      if [[ -n "$secret_b64" ]]; then
        [[ "$PROVIDER" == opencode* ]] && add_key "$secret_b64"
        raw="$(printf '%s' "$secret_b64" | base64 -d 2>/dev/null)" || true
        [[ -n "$raw" ]] && add_key "$raw"
        secret_b64=""
      fi
    done <<< "$out"
  fi
done

# Fallback: search by label hints
for hint in "chrome safe storage" "brave safe storage" "chromium safe storage" "vivaldi safe storage" "Microsoft Edge Safe Storage"; do
  if out="$(secret-tool search --all label "$hint" 2>/dev/null)"; then
    secret_b64=""
    while IFS= read -r line; do
      case "$line" in
        secret\ =\ *) secret_b64="${line#secret = }" ;;
      esac
      if [[ -n "$secret_b64" ]]; then
        [[ "$PROVIDER" == opencode* ]] && add_key "$secret_b64"
        raw="$(printf '%s' "$secret_b64" | base64 -d 2>/dev/null)" || true
        if [[ -n "$raw" ]]; then
          echo "$raw" | grep -qi "control" || add_key "$raw"
        fi
        secret_b64=""
      fi
    done <<< "$out"
  fi
done

# Always include "peanuts" fallback
add_key "peanuts"

# --- Extract cookies ---
TMPDB="$(mktemp /tmp/codexbar_cookies_XXXXXX)"

all_cookies=""
encrypted_targets=0

browser_paths=(
  "$HOME/.config/google-chrome"/*/Cookies \
  "$HOME/.config/BraveSoftware/Brave-Browser"/*/Cookies \
  "$HOME/.config/chromium"/*/Cookies \
  "$HOME/.config/vivaldi"/*/Cookies \
  "$HOME/.config/microsoft-edge"/*/Cookies \
  "$HOME/.config/microsoft-edge"/*/Network/Cookies \
  "$HOME/.var/app/com.google.Chrome/config/google-chrome"/*/Cookies \
  "$HOME/.var/app/com.microsoft.Edge/config/microsoft-edge"/*/Cookies \
  "$HOME/.var/app/com.microsoft.Edge/config/microsoft-edge"/*/Network/Cookies \
  "$HOME/.var/app/com.vivaldi.Vivaldi/config/vivaldi"/*/Cookies
)
if [[ -n "$PROFILE" ]]; then browser_paths=("$PROFILE"); fi
for browser_path in "${browser_paths[@]}"; do

  [[ -f "$browser_path" ]] || continue

  if [[ ! -r "$browser_path" ]]; then
    printf '{"error":"PERMISSION_DENIED","details":"Cannot read cookie file at %s. Try closing your browser."}\n' "$browser_path" >&2
    exit 1
  fi

  cp "$browser_path" "$TMPDB" 2>/dev/null || continue

  # Build WHERE clause
  where_clause=""
  for domain in "${DOMAINS[@]}"; do
    [[ -n "$where_clause" ]] && where_clause="${where_clause} OR "
    where_clause="${where_clause}(host_key = '${domain}' OR host_key = '.${domain}' OR host_key LIKE '%.${domain}')"
  done

  cookie_data="$(sqlite3 "$TMPDB" "SELECT host_key, name, value, hex(encrypted_value) FROM cookies WHERE ${where_clause};" 2>/dev/null)" || {
    printf '{"error":"DATABASE_ERROR","details":"Failed to read cookie database: %s"}\n' "$browser_path" >&2
    exit 1
  }

  [[ -z "$cookie_data" ]] && { rm -f "$TMPDB"; continue; }

  while IFS='|' read -r cookie_host cookie_name cookie_value enc_hex; do
    [[ -z "$cookie_name" ]] && continue

    # Check target match
    target_match=0
    for target in "${TARGETS[@]}"; do
      if { [[ "$PROVIDER" == opencode* ]] && [[ "$cookie_name" == "$target" ]]; } ||
         { [[ "$PROVIDER" != opencode* ]] && [[ "$cookie_name" == *"$target"* ]]; }; then
        target_match=1
        break
      fi
    done
    [[ $target_match -eq 0 ]] && continue

    # Count encrypted
    [[ -n "$enc_hex" ]] && ((encrypted_targets++)) || true

    # Try plaintext first
    decrypted=""
    if [[ -n "$cookie_value" ]] && is_plausible_cookie_value "$cookie_name" "$cookie_value"; then
      decrypted="$cookie_value"
    fi

    # Try decryption with each key
    if [[ -z "$decrypted" && -n "$enc_hex" ]]; then
      while IFS= read -r key_b64; do
        [[ -z "$key_b64" ]] && continue
        decoded_key="$(printf '%s' "$key_b64" | base64 -d 2>/dev/null)" || continue
        if [[ "$PROVIDER" == opencode* ]]; then
          candidate="$(decrypt_console_cookie "$enc_hex" "$decoded_key" "$cookie_host")" || continue
        else
          candidate="$(decrypt_v10 "$enc_hex" "$decoded_key")" || continue
        fi
        if is_plausible_cookie_value "$cookie_name" "$candidate"; then
          decrypted="$candidate"
          break
        fi
      done < "$KEYS_FILE"
    fi

    if [[ -n "$decrypted" ]]; then
      all_cookies="${all_cookies}${cookie_name}=${decrypted}"$'\n'
    fi
  done <<< "$cookie_data"

  # A Console session must come from one profile, never concatenated accounts.
  if [[ "$PROVIDER" == opencode* && -n "$all_cookies" ]]; then break; fi

  rm -f "$TMPDB"
done

# --- Check results ---
if [[ -z "$all_cookies" ]]; then
  details="Found no valid ${DISPLAY_NAME} cookies. Please ensure you are logged in."
  if [[ $encrypted_targets -gt 0 ]]; then
    details="${details}

Found ${encrypted_targets} encrypted ${DISPLAY_NAME} cookies, but none could be decrypted with the available browser keyring keys."
  fi
  if [[ -n "$dbus_errors" ]]; then
    details="${details}

Keyring access errors (D-Bus):
${dbus_errors}"
  fi
  printf '{"error":"SESSION_NOT_FOUND","details":"%s"}\n' "$(json_escape "$details")"
  exit 1
fi

# Check required cookie
if [[ -n "$REQUIRED_COOKIE" ]]; then
  found_required=0
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    name="${line%%=*}"
    if [[ "$name" == *"$REQUIRED_COOKIE"* ]]; then
      found_required=1
      break
    fi
  done <<< "$all_cookies"

  if [[ $found_required -eq 0 ]]; then
    printf '{"error":"SESSION_NOT_FOUND","details":"Found some cookies but no %s. Please log in."}\n' "$REQUIRED_COOKIE"
    exit 1
  fi
fi

# --- Build cookie header (priority first) ---
priority_header=""
other_header=""

while IFS= read -r line; do
  [[ -z "$line" ]] && continue
  name="${line%%=*}"
  value="${line#*=}"

  is_priority=0
  for pc in "${PRIORITY_COOKIES[@]}"; do
    if [[ "$name" == *"$pc"* ]]; then
      is_priority=1
      break
    fi
  done

  if [[ $is_priority -eq 1 ]]; then
    [[ -n "$priority_header" ]] && priority_header="${priority_header}; "
    priority_header="${priority_header}${name}=${value}"
  else
    [[ -n "$other_header" ]] && other_header="${other_header}; "
    other_header="${other_header}${name}=${value}"
  fi
done <<< "$all_cookies"

header=""
[[ -n "$priority_header" ]] && header="$priority_header"
[[ -n "$other_header" ]] && {
  [[ -n "$header" ]] && header="${header}; "
  header="${header}${other_header}"
}

printf '{"cookie_header":"%s"}\n' "$(json_escape "$header")"
