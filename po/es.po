#: prefs.js:967
msgid ""
"Install scripts/codexbar-cookie-importer from the CodexBar GNOME repository "
"into ~/.local/bin and make it executable. It requires openssl, sqlite3, and "
"secret-tool."
msgstr "Instala scripts/codexbar-cookie-importer del repositorio de CodexBar GNOME en ~/.local/bin y dale permisos de ejecución. Requiere openssl, sqlite3 y secret-tool."

#: prefs.js:1018
msgid "Timeout"
