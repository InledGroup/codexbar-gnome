msgstr "Aceptar"

#: prefs.js:1000
msgid "Cookie Importer Missing"
msgstr "Falta el importador de cookies"

#: prefs.js:1002
msgid ""
"To import cookies automatically from your browser, please install the python "
"dependency by running:\n"
"\n"
"pip install codexbar-cookie-importer"
msgstr ""
"Para importar cookies automáticamente desde tu navegador, instala la "
"dependencia de Python ejecutando:\\n\\npip install codexbar-cookie-importer"

#: prefs.js:1051
msgid "Timeout"
msgstr "Tiempo agotado"

#: prefs.js:1053
msgid ""
"The cookie importer is taking too long. Please ensure your browser is closed "
"and try again."
msgstr ""
"El importador de cookies está tardando demasiado. Asegúrate de tener el "
"navegador cerrado e inténtalo de nuevo."

