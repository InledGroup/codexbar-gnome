#: prefs.js:688
msgid ""
"Sign in at opencode.ai/console, then import cookies. With multiple "
"workspaces, copy the workspace ID from the Console URL."
msgstr "Inicia sesión en opencode.ai/console e importa las cookies. Si tienes varios espacios de trabajo, copia su ID de la URL de la consola."

#: prefs.js:696
msgid "Manual entry: Paste your session cookies here."
msgstr "Entrada manual: pega aquí tus cookies de sesión."

