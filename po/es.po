#: extension.js:1377
msgid "Please configure your system dependencies:"
msgstr "Configura las dependencias de tu sistema:"

#: extension.js:1392 extension.js:1434 extension.js:1482
msgid "● Installed"
msgstr "● Instalado"

#: extension.js:1392
msgid "● Missing"
msgstr "● Falta"

#: extension.js:1396
msgid "1. CodexBar CLI  "
msgstr "1. CodexBar CLI  "

#: extension.js:1410
msgid "Required to query AI usage metrics."
msgstr "Necesario para consultar las métricas de uso de IA."

#: extension.js:1435
msgid ""
"● Optional (only for codex users and only if you want not to find and copy "
"manually a cookie value)"
msgstr ""
"● Opcional (solo para usuarios de Codex y solo si no quieres buscar y copiar "
"manualmente el valor de una cookie)"

#: extension.js:1439
msgid "2. Cookie Importer  "
msgstr "2. Importador de cookies  "

#: extension.js:1453
msgid ""
"Enables browser auto cookie extraction for Codex (ChatGPT). This cookie is "
"used to authenticate on the usage api of OpenAI"
msgstr ""
"Permite la extracción automática de cookies del navegador para Codex "
"(ChatGPT). Esta cookie se usa para autenticarse en la API de uso de OpenAI"

#: extension.js:1483
msgid "● Optional (for Antigravity)"
msgstr "● Opcional (para Antigravity)"

#: extension.js:1487
msgid "3. AGY Server Certificate Trust Helper  "
msgstr "3. AGY Server Certificate Trust Helper  "

#: extension.js:1501
msgid ""
"Required to trust the local Antigravity server certificate. Requires "
"privilegie elevation"
msgstr ""
"Necesario para confiar en el certificado del servidor local de Antigravity. "
"Requiere elevación de privilegios"

