#: prefs.js:232
msgid "Contribute & Contact"
msgstr "Contribuir e contato"

#: prefs.js:234
msgid ""
"Enjoy the community of Codexbar contributors and other Inled projects. We "
"are waiting for you!"
msgstr ""
"Participe da comunidade de colaboradores do CodexBar e de outros projetos da "
"Inled. Estamos esperando você!"

#: prefs.js:239
msgid "Add a New Provider"
msgstr "Adicionar um novo provedor"

#: prefs.js:241
msgid "Help the community by submitting a Pull Request on GitHub"
msgstr "Ajude a comunidade enviando um Pull Request no GitHub"

#: prefs.js:261
msgid "Leave a Review"
msgstr "Deixe uma avaliação"

#: prefs.js:263
msgid "Rate the extension on EGO or share on social media."
msgstr "Avalie a extensão no EGO ou compartilhe nas redes sociais."

#: prefs.js:283
msgid "Contact Inled"
msgstr "Fale com a Inled"

#: prefs.js:284
msgid "Questions? Suggestions? Write to us at hi@inled.es"
msgstr "Dúvidas? Sugestões? Escreva para hi@inled.es"

#: prefs.js:302
msgid "Visit inled.es"
msgstr "Visite inled.es"

#: prefs.js:304
msgid "Discover more tools and projects that might interest you!"
msgstr "Conheça outras ferramentas e projetos que podem interessar você!"

#: prefs.js:321
msgid "Join the Community"
msgstr "Entre na comunidade"

#: prefs.js:322
msgid "¡We have new Discord and Matrix channels!"
msgstr "Temos novos canais no Discord e no Matrix!"

