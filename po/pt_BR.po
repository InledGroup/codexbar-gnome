msgid "Workspace ID (org_… or wrk_…; optional for a single workspace)"
msgstr ""
"ID do espaço de trabalho (org_… ou wrk_…; opcional se houver apenas um)"

#: prefs.js:689
msgid ""
"Sign in at opencode.ai/console, then import cookies. With multiple "
"workspaces, copy the workspace ID from the Console URL."
msgstr ""
"Entre em opencode.ai/console e importe os cookies. Se houver vários espaços "
"de trabalho, copie o ID da URL do Console."

#: prefs.js:697
msgid "Manual entry: Paste your session cookies here."
msgstr "Entrada manual: cole aqui os cookies de sessão."

