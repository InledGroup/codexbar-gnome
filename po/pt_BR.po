#: prefs.js:1002
msgid "Cookie Importer Missing"
msgstr "Importador de cookies ausente"

#: prefs.js:1004
msgid ""
"To import cookies automatically from your browser, please install the python "
"dependency by running:\n"
"\n"
"pip install codexbar-cookie-importer"
msgstr ""
"Para importar cookies automaticamente do navegador, instale a dependência "
"Python com:\n"
"\n"
"pip install codexbar-cookie-importer"

#: prefs.js:1053
msgid "Timeout"
msgstr "Tempo esgotado"

#: prefs.js:1055
msgid ""
"The cookie importer is taking too long. Please ensure your browser is closed "
"and try again."
msgstr ""
"O importador de cookies está demorando demais. Feche o navegador e tente de "
"novo."

