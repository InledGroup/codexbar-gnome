msgid "Cookie Importer Missing"
msgstr "Importador de cookies ausente"

#: prefs.js:939
msgid ""
"Install scripts/codexbar-cookie-importer from the CodexBar GNOME repository "
"into ~/.local/bin and make it executable. It requires openssl, sqlite3, and "
"secret-tool."
msgstr ""
"Instale scripts/codexbar-cookie-importer do repositório CodexBar GNOME em "
"~/.local/bin e dê permissão de execução. Requer openssl, sqlite3 e secret-"
"tool."

#: prefs.js:990
