msgstr "Simule saídas da CLI e veja logs de depuração."

#: prefs.js:156
msgid "Test with Custom CLI Output"
msgstr "Testar com saída personalizada da CLI"

#: prefs.js:158
msgid ""
"Simulate Codexbar-CLI outputs to test providers or other things and see how "
"the extension renders the data"
msgstr ""
"Simule saídas da codexbar-cli para testar provedores e ver como a extensão "
"exibe os dados"

